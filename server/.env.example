# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Configuration
# Option 1: Complete Connection URL (Recommended for cloud providers like Neon, Supabase, Render)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/satquery_db

# Option 2: Individual Connection Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=satquery_db
DATABASE_SSL=false

# Microservice URLs
PYTHON_API_URL=http://localhost:8000

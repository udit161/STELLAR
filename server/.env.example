# Environment variables for SERVER (Node.js/Express)
# Copy this to .env and fill in real values. Never commit the real .env file.

PORT=5000
NODE_ENV=production

# PostgreSQL — Use Render's DATABASE_URL in production (auto-injected)
# For Neon.tech (after Render's 90-day free DB expires): 
# DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/satquery?sslmode=require
DATABASE_URL=

DATABASE_SSL=true

# HuggingFace Tokens (set in Render dashboard, not here)
HF_TOKEN=
HF_READ_TOKEN=
HF_WRITE_TOKEN=

# JWT secret (auto-generated by Render, or set a strong random string)
JWT_SECRET=

# AI Agent URL — set this after deploying to Hugging Face Spaces
# Format: https://YOUR_HF_USERNAME-satquery-ai-agent.hf.space
PYTHON_API_URL=
